{
  "manifest_version": 3,
  "name": "Prolific Studies Notifier",
  "version": "4.1.0",
  "description": "Instant sound and desktop alerts for new Prolific studies. Notify-only: never joins or reserves studies for you. Free.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://app.prolific.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.prolific.com/*"
      ],
      "js": [
        "dist/content.js",
        "dist/tabWatchdog.js",
        "dist/fastMode.js"
      ]
    },
    {
      "matches": [
        "https://app.prolific.com/*"
      ],
      "js": [
        "dist/pageBridge.js"
      ],
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "title": "Prolific get studies automatically"
  },
  "icons": {
    "16": "imgs/logo-16.png",
    "48": "imgs/logo-48.png",
    "128": "imgs/logo.png"
  }
}

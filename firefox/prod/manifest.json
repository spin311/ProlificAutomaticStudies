{
  "manifest_version": 2,
  "name": "Prolific Studies Notifier",
  "version": "4.0.0",
  "description": "Firefox extension for Prolific to notify you when studies are available",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "https://app.prolific.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.prolific.com/*"
      ],
      "js": [
        "dist/content.js",
        "dist/tabWatchdog.js",
        "dist/fastMode.js",
        "dist/pageBridge.js"
      ]
    }
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Prolific get studies automatically"
  },
  "icons": {
    "16": "imgs/logo-16.png",
    "48": "imgs/logo-48.png",
    "128": "imgs/logo.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prolific_studies_notifier@example.com",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
